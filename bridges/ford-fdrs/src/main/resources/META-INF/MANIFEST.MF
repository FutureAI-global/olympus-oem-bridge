Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: FutureAI FDRS Layer 2 Bridge
Bundle-SymbolicName: com.futureai.fdrs.layer2
Bundle-Version: 0.2.5
Bundle-Vendor: FutureAI Inc
Bundle-Description: Exposes allowlisted FDRS OSGi commands via localhost
 HTTP on port 18082 so Olympus can autonomously drive FDRS. Read-only
 commands only; write ops require a safety-case-signed allowlist entry.
Bundle-Activator: com.futureai.fdrs.layer2.Activator
Import-Package: org.osgi.framework;version="[1.6,2.0)",
 com.ford.otx.command;version=0,
 com.ford.otx.command.invoker;version=0,
 com.ford.otx.services.user.command;version=0,
 com.ford.otx.services.vehicle.command;version=0,
 com.ford.otx.services.vehicle.comms.command;version=0,
 com.ford.etis.runtime.measurement.management.command;version=0
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=1.8))"

